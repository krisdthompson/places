## Sample environment configuration file
## Copy this file to hugo.env and fill in your actual settings
## hugo.env will be ignored by git, but this sample is tracked

## =============================================================
## DEVELOPMENT SETTINGS (used by start.sh)
## =============================================================
DEV_HUGO_ENV=development
DEV_HUGO_BASEURL=http://localhost:1313

## =============================================================
## PRODUCTION SETTINGS (used by build.sh and publish.sh)
## =============================================================
PROD_HUGO_ENV=production
PROD_HUGO_BASEURL=https://example.com

## Deployment settings for publish.sh
DEPLOY_USER=username
DEPLOY_HOST=example.com
DEPLOY_PATH=/var/www/html
DEPLOY_PORT=22

## Site settings
SITE_TITLE="My Places"
SITE_DESCRIPTION="A collection of my favorite places"

## API keys (replace with actual keys in hugo.env)
API_KEY=your_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here